# ==============================================================================
# ASAC Backend Environment Configuration Example (.env.example)
# Copy this file to '.env' and adjust the values according to your environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI Provider Selection
# Options: "openai", "azure_openai", "ollama"
# ------------------------------------------------------------------------------
AI_PROVIDER=azure_openai

# ------------------------------------------------------------------------------
# 2. OpenAI Configuration (Used if AI_PROVIDER="openai")
# ------------------------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# 3. Azure OpenAI Configuration (Used if AI_PROVIDER="azure_openai")
# ------------------------------------------------------------------------------
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-02-15-preview
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# ------------------------------------------------------------------------------
# 4. Ollama Configuration (Used if AI_PROVIDER="ollama")
# ------------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ------------------------------------------------------------------------------
# 5. Database & Storage Configuration
# ------------------------------------------------------------------------------
# SQLite database URL (default). For Postgres, use postgresql://user:pass@host:port/dbname
DATABASE_URL=sqlite:///./data/asac.db

# ------------------------------------------------------------------------------
# 6. Pipeline & Execution Settings
# ------------------------------------------------------------------------------
# Fallback to hardcoded mock templates if AI agent calls fail (Set to true only for offline testing)
TEMPLATE_FALLBACK=false

# Agent response timeout in seconds
AGENT_TIMEOUT=60

# Full multi-agent pipeline timeout in seconds
PIPELINE_TIMEOUT=180

# Maximum token output limit per agent call
MAX_TOKENS=950

# ------------------------------------------------------------------------------
# 7. RAG & Knowledge Base Settings
# ------------------------------------------------------------------------------
# Number of top matching chunks to retrieve for RAG context
RAG_TOP_K=5

# Relative or absolute directory containing reference knowledge docs
KNOWLEDGE_DIR=knowledge

# ------------------------------------------------------------------------------
# 8. Security & CORS Origins
# Comma-separated list of allowed frontend origins for CORS
# ------------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost
